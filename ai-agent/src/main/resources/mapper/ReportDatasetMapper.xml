<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="org.example.ai.agent.business.dataset.mapper.ReportDatasetMapper">

    <select id="selectEnabledByCode"
            resultType="org.example.ai.agent.business.dataset.entity.ReportDataset">
        SELECT *
        FROM ai_report_dataset
        WHERE dataset_code = #{datasetCode}
          AND enabled = 1
        LIMIT 1
    </select>
</mapper>
